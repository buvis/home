{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.03,
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "MAX_THINKING_TOKENS": "31999",
    "NTFY_URL": "https://ntfy.buvis.net",
    "NTFY_TOPIC": "claude"
  },
  "permissions": {
    "allow": [
      "Read(~/git/**)",
      "Edit(./**)",
      "Edit(~/git/**/docs/dev/project-management/**)",
      "Edit(~/git/**/docs/dev/tmp/**)",
      "Read(//tmp/**)",
      "Read(//tmp/*)",
      "Read(//private/tmp/**)",
      "Read(//private/tmp/*)",
      "Read(//var/folders/**)",
      "Read(//var/folders/*)",
      "Read(//private/var/folders/**)",
      "Read(//private/var/folders/*)",
      "Edit(//tmp/**)",
      "Edit(//tmp/*)",
      "Edit(//private/tmp/**)",
      "Edit(//private/tmp/*)",
      "Edit(//var/folders/**)",
      "Edit(//var/folders/*)",
      "Edit(//private/var/folders/**)",
      "Edit(//private/var/folders/*)",
      "Read(tmp/**)",
      "Read(tmp/*)",
      "Read(**/tmp/**)",
      "Read(**/tmp/*)",
      "Edit(tmp/**)",
      "Edit(tmp/*)",
      "Edit(**/tmp/**)",
      "Edit(**/tmp/*)",
      "WebSearch",
      "WebFetch(*)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/.archive/**)",
      "Read(~/.claude/.archive/*)",
      "Read(~/.claude/rules-library/**)",
      "Read(~/.claude/rules-library/*)",
      "Read(~/.claude/docs/dev/project-management/**)",
      "Read(~/.claude/docs/dev/project-management/*)",
      "Edit(~/.claude/docs/dev/project-management/**)",
      "Edit(~/.claude/docs/dev/project-management/*)",
      "Read(~/.claude/docs/dev/tmp/**)",
      "Read(~/.claude/docs/dev/tmp/*)",
      "Edit(~/.claude/docs/dev/tmp/**)",
      "Edit(~/.claude/docs/dev/tmp/*)",
      "mcp__claude_ai_Context7__*",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(cargo:*)",
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(showboat:*)",
      "Bash(zdb:*)",
      "Bash(ast-grep:*)",
      "Bash(mdbook:*)",
      "Bash(codex:*)",
      "Bash(copilot:*)",
      "Bash(claude:*)",
      "Bash(mise:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(xxd:*)",
      "Bash(test:*)",
      "Bash(timeout:*)",
      "Bash(lsof:*)",
      "Bash(dig:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(mkdocs:*)",
      "Bash(rmdir:*)",
      "Bash(shellcheck:*)",
      "Bash(rustc:*)",
      "Bash(gpgconf:*)",
      "Bash(ddb:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(sqlite3:*)",
      "Bash(jq:*)",
      "Bash(stat:*)",
      "Bash(du:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials.json)",
      "Read(**/.ntfy-secret*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": []
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/reinject_contract_card.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/bob/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/bob/.config/herdr/plugins/config/resilient-software.agent-activity/hook.sh' claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/dispatch.py pre",
            "timeout": 25
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notify.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notify.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/dispatch.py stop",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/bob/.config/herdr/plugins/config/resilient-software.agent-activity/hook.sh' claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Agent|WebFetch|WebSearch|mcp__.*|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/dispatch.py post",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/bob/.config/herdr/plugins/config/resilient-software.agent-activity/hook.sh' claude",
            "timeout": 10,
            "async": true
          }
        ],
        "matcher": "Bash|Monitor|Agent|Task|CronCreate|CronDelete|ScheduleWakeup|TaskStop|KillShell|KillBash"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": false,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/bob/.config/herdr/plugins/config/resilient-software.agent-activity/hook.sh' claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "'/Users/bob/.local/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/bob/.config/herdr/plugins/config/resilient-software.agent-activity/hook.sh' claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/bob/.config/herdr/plugins/config/resilient-software.agent-activity/hook.sh' claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/bob/.config/herdr/plugins/config/resilient-software.agent-activity/hook.sh' claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(ls -d \"$HOME\"/.claude/plugins/cache/ponytail/ponytail/*/hooks/ponytail-statusline.sh | sort -V | tail -n1)\""
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "warden@buvis-plugins": true,
    "git-ferry@buvis-plugins": true,
    "strunk@buvis-plugins": true,
    "aegis@buvis-plugins": true,
    "claude-checkup@buvis-plugins": true,
    "ponytail@ponytail": true,
    "loupe@buvis-plugins": true,
    "agoge@buvis-plugins": true,
    "autopilot@buvis-plugins": true
  },
  "extraKnownMarketplaces": {
    "buvis-plugins": {
      "source": {
        "source": "github",
        "repo": "buvis/claude-plugins"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Writes, edits, and deletes under any `docs/dev/project-management/` directory (including `~/.claude/docs/dev/project-management/`) are working documents — PRDs, autopilot state, scratch files, plans, signal files. They are NOT agent configuration or self-modification. Allow without prompting.",
      "Reads, writes, edits, and deletes under any temporary directory — absolute (`/tmp/`, `/private/tmp/`, `/var/folders/`, `/private/var/folders/`) or relative (`tmp/`, `**/tmp/`) — are scratch artifacts (dispatch prompts, test logs, intermediate files). They are NOT agent configuration or self-modification. Allow without prompting."
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: not queryable here (no remotes configured for this repo) — unknown",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo only — this repo (/Users/bob/.claude) has no git remotes configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — noted candidates in this repo: .credentials.json, hooks/.ntfy-secret, hooks/.ntfy-secret.secret, plugins/marketplaces/ponytail/.env.example",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: The git repository the agent started in (/Users/bob/.claude) — it has no configured remotes, so scope trust to the local working directory only",
      "**Org-specific CLIs**: None configured — frequent non-standard CLIs observed in this project: uv, sqlite3, claude, engram, mise, ast-grep, gita",
      "routine under ~/.claude/docs/dev/project-management/ prefix: working documents (PRDs, autopilot state, scratch files, plans, signal files) — allowed without prompting per existing auto-mode config",
      "routine under any tmp/ or temporary directory prefix (/tmp/, /private/tmp/, /var/folders/, /private/var/folders/, tmp/, **/tmp/): scratch artifacts — allowed without prompting per existing auto-mode config"
    ]
  }
}
