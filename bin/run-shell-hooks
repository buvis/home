#!/usr/bin/env bash
#
# run-shell-hooks - run scheduled tasks visibly at shell start.
#
# Tasks come from two YAML files, deep-merged so the second wins per key:
#   ${XDG_CONFIG_HOME:-~/.config}/shell-hooks/tasks.yaml   global, tracked in buvis
#   ~/.local/.config/shell-hooks/tasks.yaml                machine-local, untracked
#
#   tasks:
#     gita-pull:
#       every: 1d          # <N>(m|h|d|w)
#       run: gita pull     # one line, passed to bash -c; point it at a script for more
#       icon: 🔄           # optional, marks the task header when it runs (default ▶)
#     brew-up:
#       every: 1w
#       run:               # a list (or a `run: |` block, one command per line) runs the
#         - brew update    # lines in order, each under a "▸ <line>" header, and stops at
#         - brew upgrade   # the first failure
#   A local entry may override any key of a global task or set `enabled: false`.
#
# State: ${XDG_STATE_HOME:-~/.local/state}/shell-hooks/<task>.last = "<epoch> <rc>".
# A task is due when its interval has passed since the last attempt. A failed task
# is reported on every shell start until a run exits 0. Needs yq v4 (mise installs it).
#
# Usage:
#   run-shell-hooks              run due tasks (the bash-it plugin calls this before the first prompt)
#   run-shell-hooks <task>       run one task now, ignoring its interval
#   run-shell-hooks --list       show tasks, interval, last run, last exit code
#   run-shell-hooks --self-test  exercise merge, override, disable and failure memory in a temp HOME
#   run-shell-hooks --help       show this text

set -uo pipefail

global="${XDG_CONFIG_HOME:-$HOME/.config}/shell-hooks/tasks.yaml"
local_cfg="$HOME/.local/.config/shell-hooks/tasks.yaml"
state="${XDG_STATE_HOME:-$HOME/.local/state}/shell-hooks"
now=$(date +%s)
mode=${1:-}

seconds() {
  [[ $1 =~ ^([0-9]+)([mhdw])$ ]] || return 1
  local n=${BASH_REMATCH[1]}
  case ${BASH_REMATCH[2]} in
    m) echo $((n * 60)) ;;
    h) echo $((n * 3600)) ;;
    d) echo $((n * 86400)) ;;
    w) echo $((n * 604800)) ;;
  esac
}

ago() {
  if (( $1 == 0 )); then echo never; else echo "$(( (now - $1) / 3600 ))h ago"; fi
}

self_test() {
  local tmp out yq_dir
  tmp="$(mktemp -d)"
  yq_dir="$(dirname "$(mise which yq 2>/dev/null || command -v yq)")" # the mise shim needs the real HOME
  mkdir -p "$tmp/.config/shell-hooks" "$tmp/.local/.config/shell-hooks"
  printf 'tasks:\n  a: {every: 1d, run: echo A}\n  b: {every: 1d, run: echo B}\n  c: {every: 1d, run: exit 3}\n' > "$tmp/.config/shell-hooks/tasks.yaml"
  printf 'tasks:\n  b: {enabled: false}\n  d: {every: 1h, run: echo D}\n' > "$tmp/.local/.config/shell-hooks/tasks.yaml"
  out="$(PATH="$yq_dir:$PATH" HOME=$tmp XDG_CONFIG_HOME=$tmp/.config XDG_STATE_HOME=$tmp/.local/state "$0" 2>&1)"
  [[ $out == *A* && $out == *D* && $out != *B* ]] || { echo "self-test: merge/disable failed: $out" >&2; exit 1; }
  [[ "$(<"$tmp/.local/state/shell-hooks/c.last")" == *" 3" ]] || { echo "self-test: rc not stamped" >&2; exit 1; }
  out="$(PATH="$yq_dir:$PATH" HOME=$tmp XDG_CONFIG_HOME=$tmp/.config XDG_STATE_HOME=$tmp/.local/state "$0" 2>&1)"
  [[ $out == *"c failed"* && $out != *A* ]] || { echo "self-test: failure memory failed: $out" >&2; exit 1; }
  out="$(PATH="$yq_dir:$PATH" HOME=$tmp XDG_CONFIG_HOME=$tmp/.config XDG_STATE_HOME=$tmp/.local/state "$0" c 2>&1)"
  [[ $out == *"━━ ▶ c ━━"* ]] || { echo "self-test: forced run failed: $out" >&2; exit 1; }
  printf 'tasks:\n  e: {every: 1d, run: [echo E1, echo E2], icon: 🔄}\n  f: {every: 1d, run: [exit 4, echo NOPE]}\n  g:\n    every: 1d\n    run: |\n      echo G1\n      echo G2\n' > "$tmp/.config/shell-hooks/tasks.yaml"
  out="$(PATH="$yq_dir:$PATH" HOME=$tmp XDG_CONFIG_HOME=$tmp/.config XDG_STATE_HOME=$tmp/.local/state "$0" 2>&1)"
  [[ $out == *"━━ 🔄 e ━━"* && $out == *"▸ echo E1"* && $out == *$'\nE2\n'* && $out != *NOPE* ]] || { echo "self-test: list run failed: $out" >&2; exit 1; }
  [[ $out == *"▸ echo G2"* && $out == *$'\nG2'* ]] || { echo "self-test: block run failed: $out" >&2; exit 1; }
  [[ "$(<"$tmp/.local/state/shell-hooks/f.last")" == *" 4" ]] || { echo "self-test: list run rc not stamped" >&2; exit 1; }
  rm -rf "$tmp"
  echo "self-test ok"
}

case $mode in
  -h | --help) sed -n '2,/^$/{s/^# \{0,1\}//;p;}' "$0"; exit 0 ;;
  --self-test) self_test; exit 0 ;;
esac

command -v yq >/dev/null || { echo "shell-hooks: yq not found, run: mise install" >&2; exit 0; }

files=()
for f in "$global" "$local_cfg"; do [[ -f $f ]] && files+=("$f"); done
[[ ${#files[@]} -eq 0 ]] && exit 0

# Merge local over global by key; with one file, merging it with itself is the identity.
# A list or multi-line `run` keeps its steps apart with \x1e; the run loop below splits them again.
tasks="$(SEP=$'\x1f' STEP=$'\x1e' yq ea 'select(fi == 0) * select(fi == 1) | .tasks // {} | to_entries[] | select(.value.enabled != false) | with(select(.value.run | tag == "!!seq"); .value.run |= join(strenv(STEP))) | with(select(.value.run | tag == "!!str"); .value.run |= (split("\n") | map(select(. != "")) | join(strenv(STEP)))) | [.key, .value.every // "", .value.run // "", .value.icon // ""] | join(strenv(SEP))' "${files[0]}" "${files[1]:-${files[0]}}")" \
  || { echo "shell-hooks: cannot parse ${files[*]}" >&2; exit 0; }

mkdir -p "$state"

if [[ $mode == --list ]]; then
  printf '%-20s %-6s %-12s %s\n' TASK EVERY LAST RC
  while IFS=$'\x1f' read -r -u 3 name every run icon; do
    [[ -z $name ]] && continue
    read -r last rc 2>/dev/null < "$state/$name.last" || { last=0; rc=-; }
    printf '%-20s %-6s %-12s %s\n' "$name" "$every" "$(ago "$last")" "$rc"
  done 3<<< "$tasks"
  exit 0
fi

[[ -t 1 ]] && hl=$'\e[1;97;44m' off=$'\e[0m' || hl= off= # bold base3 on blue (#268bd2) in a solarized palette

# ponytail: one global lock, tasks run sequentially; per-task locks if parallel runs are wanted
if ! mkdir "$state/.lock" 2>/dev/null && kill -0 "$(cat "$state/.lock/pid" 2>/dev/null)" 2>/dev/null; then
  echo "shell-hooks: running in another shell, skipping"
  exit 0
fi
echo $$ > "$state/.lock/pid"
trap 'rm -rf "$state/.lock"' EXIT

found=0
while IFS=$'\x1f' read -r -u 3 name every run icon; do
  [[ -z $name ]] && continue
  [[ -n $mode && $mode != "$name" ]] && continue
  found=1
  if [[ -z $every || -z $run ]] || ! period=$(seconds "$every"); then
    echo "shell-hooks: $name: needs every (<N>m|h|d|w) and run" >&2
    continue
  fi
  read -r last rc 2>/dev/null < "$state/$name.last" || { last=0; rc=0; }
  if [[ -n $mode ]] || (( now - last >= period )); then
    printf '\n%s━━ %s %s ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "$hl" "${icon:-▶}" "$name" "$off"
    IFS=$'\x1e' read -r -a steps <<< "$run"
    rc=0
    for step in "${steps[@]}"; do
      (( ${#steps[@]} > 1 )) && echo "▸ $step"
      bash -c "$step" || { rc=$?; break; }
    done
    echo "$(date +%s) $rc" > "$state/$name.last"
    (( rc == 0 )) || echo "shell-hooks: $name failed (rc $rc)" >&2
  elif (( rc != 0 )); then
    echo "shell-hooks: $name failed $(ago "$last") (rc $rc), rerun: run-shell-hooks $name" >&2
  fi
done 3<<< "$tasks"

if [[ -n $mode && $found -eq 0 ]]; then
  echo "shell-hooks: no task named '$mode'" >&2
  exit 1
fi
