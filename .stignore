// ============================================================
// Syncthing ignore patterns for macOS home folder backup
// Place this as ~/.stignore in the synced folder
//
// Rule of thumb for pre-wipe handover:
//   - Locked runtime files (WAL/SHM while app runs)  -> ignore
//   - Build artifacts / re-downloadable caches       -> ignore
//   - Secrets, local config, workspace state         -> KEEP
//   - When in doubt, KEEP. Prune archive later.
// ============================================================

// ---- Environment files: NEVER ignore (contain secrets) ----
// .env, .env.local, .env.*.local are all KEPT intentionally.
// Do not add patterns for these.

// ============================================================
// Already in different Folder ID
// ============================================================
.local/
bim/reference/local

// ============================================================
// macOS system cruft
// ============================================================
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100
.PKInstallSandboxManager
.PKInstallSandboxManager-SystemSoftware
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDouble
.LSOverride
Icon?
.apdisk

// ============================================================
// macOS user-level system/runtime dirs (locked or massive)
// ============================================================
Library/Caches
Library/Logs
Library/Application Support/CrashReporter
// iOS backups - huge; remove line if this is the only copy
Library/Application Support/MobileSync/Backup
// locked while Mail runs
Library/Mail/V*/MailData/Envelope Index*
Library/Mail Downloads
// iCloud Drive - synced separately via bim/local folder, and iCloud itself
// manages replication. Including it here causes stat-inflated size reports
// (dataless files show full logical size) and Syncthing/iCloud conflicts.
Library/Mobile Documents
Library/Metadata/CoreSpotlight
Library/Metadata/com.apple.IntelligentSuggestions
// Containers and Group Containers are almost entirely TCC-sandboxed on
// modern macOS (Sonoma+). Syncthing logs showed 870+ distinct "operation
// not permitted" errors under these trees. Blanket-ignore both.
// Tradeoff: some sandboxed apps store real documents under Containers/<bundle>/Data,
// but since macOS blocks reading them, backing up via Syncthing is not viable anyway.
// Use app-native export (Contacts, Notes, Messages, etc.) if you need that data.
Library/Containers
Library/Group Containers
Library/Saved Application State
Library/WebKit
Library/Suggestions
Library/Assistant
Library/Biome
// locked SQLite WALs
Library/Accounts
// locked
Library/IdentityServices
// locked
Library/HomeKit
// locked AND sensitive - export via Keychain Access separately
Library/Keychains
Library/Messages/chat.db-wal
Library/Messages/chat.db-shm
Library/CallHistoryDB
Library/CallHistoryTransactions
Library/FrontBoard
Library/DuetExpertCenter
// on-device intelligence; mostly locked (duplicate of earlier Library/Biome entry)
Library/Biome
Library/CoreFollowUp
Library/Reminders/Container_v1/Stores/*-wal
Library/Reminders/Container_v1/Stores/*-shm
Library/Calendars/*.wal
Library/Calendars/*.shm
// locked, system-managed
Library/Application Support/com.apple.TCC
Library/Application Support/CallHistoryDB
// locked
Library/Application Support/Knowledge

// ============================================================
// Safari: only true caches (favicons). Quit Safari before sync.
// LocalStorage, Databases, Cookies are KEPT - they hold real state.
// ============================================================
Library/Safari/Favicon Cache
Library/Safari/Touch Icons Cache
// Library/Safari/Downloads.plist                     // uncomment to drop download history

// ============================================================
// SQLite/database runtime sidecars (keep the .db, drop the WAL/SHM)
// ============================================================
*-wal
*-shm
*.db-journal
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

// ============================================================
// Generic caches & temp
// ============================================================
*.tmp
*.temp
*.swp
*.swo
// generic XDG cache dir (at any depth)
.cache
.tmp
tmp

// ============================================================
// Trash, shell session scratch
// ============================================================
.Trash
.zsh_sessions
.bash_sessions
.lesshst
.wget-hsts
.sudo_as_admin_successful
// NOTE: .zsh_history and .bash_history are KEPT (useful command history)
// NOTE: .viminfo is KEPT (marks, recent files) - remove this line to ignore it

// ============================================================
// Downloads (optional - uncomment if you want to skip)
// ============================================================
// Downloads

// ============================================================
// Developer tooling - version managers & language runtimes
// ============================================================
.rustup
.cargo/registry
.cargo/git
.cargo/.package-cache
.cargo/.global-cache
.npm
.npm-packages
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnpm-store
.bun/install/cache
.deno/gen
.deno/deps
.nvm/.cache
// reinstallable; remove to keep
.nvm/versions
.fnm
.volta/tools
.nodenv/versions
.pyenv/versions
.pyenv/cache
.rbenv/versions
.rbenv/cache
.asdf/installs
.asdf/downloads
// reinstallable
.asdf/plugins
.local/share/mise/installs
.local/share/mise/downloads
.local/share/mise/cache
.mise/cache
.local/share/uv
.local/share/pipx/venvs
.local/share/virtualenvs
.local/pipx/.cache
.goenv/versions

