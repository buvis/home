{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "'/Users/bob/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 '/Users/bob/.codex/hooks/design-quality-check.py'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 '/Users/bob/.codex/hooks/protect_config.py'",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "python3 '/Users/bob/.codex/hooks/enforce_prd_location.py'",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "python3 '/Users/bob/.codex/hooks/block-suppression-markers.py'",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "python3 '/Users/bob/.codex/hooks/gateguard-fact-force.py'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "python3 '/Users/bob/.codex/hooks/validate_commit_msg.py'",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "python3 '/Users/bob/.codex/hooks/block_working_document_redirects.py'",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "python3 '/Users/bob/.codex/hooks/enforce_prd_location.py'",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "python3 '/Users/bob/.codex/hooks/gateguard-fact-force.py'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'/Users/bob/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec node \"$HOME/.config/herdr-app/mods/revive/revive.mjs\" hook'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 '/Users/bob/.codex/hooks/track_cost.py'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "'/Users/bob/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'/Users/bob/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec node \"$HOME/.config/herdr-app/mods/revive/revive.mjs\" hook'",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
