{
  "id": "root",
  "cloned_from": {
    "name": "my-main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "my-space-folders"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "my-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "ship-it",
          "type": "block",
          "content": {
            "mod": "ship-it"
          },
          "size": {
            "px": 40
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "my-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "filetree"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "reviewer"
                      }
                    },
                    {
                      "id": "ship-it-review",
                      "type": "block",
                      "content": {
                        "mod": "ship-it-review"
                      }
                    },
                    {
                      "id": "ship-it-prs",
                      "type": "block",
                      "content": {
                        "mod": "ship-it-prs"
                      }
                    },
                    {
                      "id": "tab-notes",
                      "type": "block",
                      "content": {
                        "mod": "tab-notes"
                      }
                    },
                    {
                      "id": "projects",
                      "type": "block",
                      "content": {
                        "mod": "bim-projects"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "phone-alerts",
              "type": "block",
              "content": {
                "mod": "pager"
              },
              "size": {
                "px": 270
              }
            }
          ],
          "size": {
            "px": 28
          },
          "resizable": false
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "floating": [
    {
      "id": "nav",
      "content": {
        "mod": "nav"
      },
      "edge": "bottom",
      "align": "end"
    },
    {
      "id": "last-pane",
      "content": {
        "mod": "last-pane"
      },
      "edge": "bottom",
      "align": "start"
    }
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/buvis.svg",
  "terminal_menu": "on-screen"
}
