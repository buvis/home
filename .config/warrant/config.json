{
  "_comment": "Mirror of the file-write allow list in ~/.config/seatbelt/ai-agents.sb (2026-10-16). Edit both together. warrant refuses an executable under these paths and re-hashes argument files under them right before launch. The project dir of a run-agent session is also writable but unknown here; ~/git/src covers the usual repos.",
  "agent_writable_roots": [
    "~/.claude",
    "~/.claude.json",
    "~/.cache",
    "~/.ollama",
    "~/.Trash",
    "~/git/src",
    "~/.kiro",
    "~/Library/Application Support/kiro-cli",
    "~/.aws/sso/cache",
    "~/.copilot",
    "~/.codex",
    "~/.pi",
    "~/Library/Caches",
    "~/Library/Logs",
    "~/.local/state",
    "~/.local/share/engram",
    "~/.gemini",
    "~/.local/share/mise",
    "~/.config/mise",
    "~/.npm/_cacache",
    "~/.npm/_logs",
    "~/.cargo/registry",
    "~/.cargo/git",
    "~/go/pkg/mod",
    "~/Library/pnpm/store",
    "~/Library/Developer/Xcode/DerivedData",
    "~/Applications",
    "~/.local/share/claude",
    "/private/tmp",
    "/tmp",
    "/private/var/folders",
    "/var/folders",
    "/dev"
  ],
  "agent_writable_globs": [
    "~/.local/bin/claude*",
    "~/.local/bin/.claude*"
  ],
  "trusted_exe_roots": [
    "/usr/bin",
    "/bin",
    "/usr/sbin",
    "/sbin",
    "/usr/libexec",
    "/opt/homebrew",
    "/System/Library",
    "/Library/Apple",
    "/Applications",
    "~/bin"
  ],
  "allowed_env": [
    "GIT_AUTHOR_NAME",
    "GIT_AUTHOR_EMAIL",
    "GIT_COMMITTER_NAME",
    "GIT_COMMITTER_EMAIL",
    "GIT_AUTHOR_DATE",
    "GIT_COMMITTER_DATE",
    "TZ"
  ],
  "exec_path": "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin",
  "inherit_env": ["SSH_AUTH_SOCK"],
  "request_ttl_sec": 86400,
  "exec_timeout_sec": 600
}
